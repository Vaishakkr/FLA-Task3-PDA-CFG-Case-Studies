digraph "DPDA - balanced brackets" {
  rankdir=LR;
  node [shape=circle fontname="Helvetica" fontsize=12];
  edge [fontname="Helvetica" fontsize=10];
  __s [shape=point width=0.08];
  "q0" [shape=circle];
  "q1" [shape=circle];
  "qf" [shape=doublecircle];
  __s -> "q0";
  "q0" -> "q1" [label="(, Z0 / (Z0\l[, Z0 / [Z0\l{, Z0 / {Z0\l"];
  "qf" -> "q1" [label="(, Z0 / (Z0\l[, Z0 / [Z0\l{, Z0 / {Z0\l"];
  "q1" -> "q1" [label="(, ( / ((\l(, [ / ([\l(, { / ({\l[, ( / [(\l[, [ / [[\l[, { / [{\l{, ( / {(\l{, [ / {[\l{, { / {{\l), ( / ε\l], [ / ε\l}, { / ε\l"];
  "q1" -> "qf" [label="ε, Z0 / Z0\l"];
}