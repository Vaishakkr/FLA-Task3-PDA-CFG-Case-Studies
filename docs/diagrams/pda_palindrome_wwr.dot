digraph "NPDA - w wR (even palindromes)" {
  rankdir=LR;
  node [shape=circle fontname="Helvetica" fontsize=12];
  edge [fontname="Helvetica" fontsize=10];
  __s [shape=point width=0.08];
  "q0" [shape=circle];
  "q1" [shape=circle];
  "q2" [shape=doublecircle];
  __s -> "q0";
  "q0" -> "q0" [label="a, Z0 / aZ0\la, a / aa\la, b / ab\lb, Z0 / bZ0\lb, a / ba\lb, b / bb\l"];
  "q0" -> "q1" [label="ε, Z0 / Z0\lε, a / a\lε, b / b\l"];
  "q1" -> "q1" [label="a, a / ε\lb, b / ε\l"];
  "q1" -> "q2" [label="ε, Z0 / Z0\l"];
}